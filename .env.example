# Optional: set a stable secret of at least 32 random characters.
# If omitted, Hass Panel creates /config/hass-panel/.jwt_secret on first start.
HASS_PANEL_SECRET_KEY=

# Optional comma-separated origins for cross-origin development clients.
# Production and HA Ingress are same-origin and should leave this empty.
HASS_PANEL_CORS_ORIGINS=

# Only used by the optional legacy test-user helper.
HASS_PANEL_TEST_ADMIN_PASSWORD=
